# RSTC App Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# JWT (required - must be set to a secure random string)
JWT_SECRET=your_secure_jwt_secret_here

# Initial Admin Password (required for first boot)
INIT_ADMIN_PASSWORD=admin1234

# CORS Origin (optional, set to your frontend URL if different)
CORS_ORIGIN=false

# Database Path (optional, defaults to ./rstc.db)
DB_PATH=./rstc.db
